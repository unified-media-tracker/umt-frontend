VITE_API_BASE_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=umt
VITE_KEYCLOAK_CLIENT_ID=umt-frontend
# core-service has GET /api/core/media, /{id} and /{id}/similar now (real data), but not
# search/rumor/status-history/purchase-links yet. true serves everything from
# apps/web/src/mocks (offline dev, all sections populated); false hits core-service
# directly for every call - the pages already catch()-and-default the ones that aren't
# backed yet, so those sections just render empty rather than mock data.
VITE_USE_MOCKS=true
